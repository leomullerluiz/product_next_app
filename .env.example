# Copy to `.env.local` and fill in the values.
# Only NEXT_PUBLIC_* variables reach the browser. Under `output: "export"` there is
# no Next.js server at runtime, so every value here is public by definition.

# Base URL of the external API consumed by services/*
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Public URL of this site (used by metadataBase / canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry (optional): leave empty to keep error reporting disabled.
# To enable: `npm install @sentry/nextjs`, fill the DSN below and follow docs/SENTRY.md
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
